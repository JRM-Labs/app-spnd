{
  "functions": {
    "source": "dist/apps/functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm exec nx run functions:build:production",
      "npm exec nx run functions:prune"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
